NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
DB_PATH=./data/bendemen.sqlite

# MySQL migratieconfiguratie
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis connectiviteit (REDIS_URL of de losse REDIS_HOST/REDIS_PORT-instellingen)
REDIS_URL=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_CACHE_PREFIX=bendemen:supply-panel:cache:
REDIS_SESSION_PREFIX=bendemen:supply-panel:sess:
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
# Alleen tijdelijk instellen bij het aanmaken/wijzigen van het adminwachtwoord (minimaal 12 tekens).
ADMIN_PASSWORD=
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_TOKEN=
WC_STORE_URL=https://jouw-woocommerce-domein.nl
WC_BRIDGE_SECRET=plak_hier_de_geheime_sleutel_uit_WooCommerce_Supply_Bridge
PANEL_PUBLIC_URL=https://klant.bendemen.nl
SMTP_HOST=mail.jouwdomein.nl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=supplypanel@notifications.bendemen.com
SMTP_PASS=vervang_mij
SMTP_FROM=supplypanel@notifications.bendemen.com
SMTP_REPLY_TO=info@bendemen.nl
